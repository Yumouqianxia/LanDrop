<Window x:Class="LanDrop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="局域网搬家 2.3.0" Width="960" Height="760" MinWidth="820" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,22">
            <Grid>
                <StackPanel>
                    <TextBlock Text="局域网搬家" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="无需共享文件夹或账户权限，直接在两台电脑之间传输。" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EFF6FF" CornerRadius="16" Padding="12,6">
                    <TextBlock x:Name="NetworkStateText" Text="正在检查网络…" Foreground="#1D4ED8" FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="ModeTabs" Margin="24" Background="Transparent" BorderThickness="0">
            <TabItem Header="从这台电脑发送">
                <Grid Margin="4,20,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="选择要迁移的内容" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="只会发送这里添加的文件和文件夹。程序不会读取其他位置。" Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Content="添加文件" Click="AddFiles_Click" Margin="0,0,8,0"/>
                            <Button Content="添加文件夹" Click="AddFolder_Click"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Margin="0,16" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <ListBox x:Name="SendItemsList" BorderThickness="0" Margin="8" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,7">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding FullPath}" Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="#64748B" Margin="16,0,4,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="SendEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="尚未添加内容" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#334155"/>
                                <TextBlock Text="添加整个游戏文件夹，或一次选择多个文件。" Margin="0,6,0,0" Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="接收电脑 IP" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="SendTargetIpBox" ToolTip="例如 192.168.50.163" AutomationProperties.Name="接收电脑 IP 地址"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="自动搜索" Click="Discover_Click" Margin="10,25,10,0"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="接收端六位配对码" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="SendPairCodeBox" MaxLength="6" ToolTip="接收电脑显示的六位配对码" AutomationProperties.Name="接收端六位配对码"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="3" Margin="0,0,0,14" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="SenderCurrentFileText" Text="尚未开始传输" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="SenderProgress" Height="10" Minimum="0" Maximum="100" Margin="0,10,0,0"/>
                            <Grid Margin="0,9,0,0">
                                <TextBlock x:Name="SenderProgressDetailText" Text="0%" Foreground="{StaticResource MutedTextBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="SenderSpeedText" Text="" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock x:Name="SenderEtaText" Text="" Margin="16,0,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="4">
                        <Button Content="移除选中项" Click="RemoveSelected_Click" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="ShareStatusText" Text="准备就绪" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource MutedTextBrush}"/>
                            <Button x:Name="WaitForReceiverButton" Content="等待接收端连接" Click="WaitForReceiver_Click" Margin="0,0,8,0"/>
                            <Button x:Name="StartShareButton" Content="连接并发送" Style="{StaticResource PrimaryButton}" Click="StartShare_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="接收到这台电脑">
                <Grid Margin="4,20,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="接收连接方式" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="推荐等待发送电脑主动连接；也可以保留原方式，主动连接正在等待的发送端。" Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="保存位置" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="DestinationBox" IsReadOnly="True" AutomationProperties.Name="保存位置"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="选择保存位置" Click="ChooseDestination_Click" Margin="10,25,0,0"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="发送电脑 IP（原连接方向）" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="LegacyServerIpBox" ToolTip="例如 192.168.1.229" AutomationProperties.Name="发送电脑 IP 地址"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="发送端配对码" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="LegacyPairCodeBox" MaxLength="6" AutomationProperties.Name="发送端六位配对码"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="ConnectSenderButton" Content="主动连接发送端" Click="ConnectSender_Click" Margin="10,25,0,0"/>
                    </Grid>
                    <Border Grid.Row="3" Margin="0,16" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ReceiveStatusText" Text="等待连接" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="ReceivePairCodeText" Text="尚未生成配对码" Margin="0,8,0,0" FontSize="27" FontWeight="Bold" Foreground="#1D4ED8"/>
                            <TextBlock x:Name="CurrentFileText" Text="点击开始等待后，接收端会监听发送电脑的主动连接。" Margin="0,7,0,14" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar x:Name="TransferProgress" Height="10" Minimum="0" Maximum="100" Value="0"/>
                            <Grid Margin="0,10,0,0">
                                <TextBlock x:Name="ProgressDetailText" Text="0%" Foreground="{StaticResource MutedTextBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="SpeedText" Text="" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock x:Name="ReceiveEtaText" Text="" Margin="16,0,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button Grid.Row="4" x:Name="ReceiveButton" Content="开始等待发送" Style="{StaticResource PrimaryButton}" Click="Receive_Click" HorizontalAlignment="Right" MinWidth="150"/>
                </Grid>
            </TabItem>

            <TabItem Header="消息与剪贴板">
                <Grid Margin="4,20,4,4" KeyboardNavigation.TabNavigation="Cycle">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="发送文字和剪贴板内容" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="消息使用独立连接，不会打断文件传输。任意一端开始等待，另一端输入 IP 和配对码连接。" Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="对方电脑 IP" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="MessagePeerIpBox" ToolTip="例如 192.168.50.163" AutomationProperties.Name="消息对方电脑 IP"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="对方配对码" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="MessagePeerCodeBox" MaxLength="6" AutomationProperties.Name="消息对方六位配对码"/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="MessageListenButton" Content="开始等待消息" Click="MessageListen_Click" Margin="10,25,8,0" MinWidth="125"/>
                        <Button Grid.Column="3" x:Name="MessageConnectButton" Content="连接" Style="{StaticResource PrimaryButton}" Click="MessageConnect_Click" Margin="0,25,0,0" MinWidth="90"/>
                    </Grid>

                    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Background="#F8FAFC">
                                <TextBlock x:Name="MessageStatusText" Text="尚未连接" Margin="14,10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="MessageLocalCodeText" Text="" Margin="14,10" HorizontalAlignment="Right" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                            </Grid>
                            <ListBox Grid.Row="1" x:Name="MessageList" BorderThickness="0" Margin="8" SelectionMode="Single" AutomationProperties.Name="消息记录">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,9">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="{Binding TimeText}" Margin="10,0,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Text}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="MessageComposerBox" MinHeight="72" MaxHeight="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="输入要发送的文字" AutomationProperties.Name="消息内容"/>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Button Content="粘贴" Click="PasteMessage_Click" MinWidth="100" Margin="0,0,0,8"/>
                            <Button Content="复制选中消息" Click="CopyMessage_Click" MinWidth="100" Margin="0,0,0,8"/>
                            <Button x:Name="SendMessageButton" Content="发送" Style="{StaticResource PrimaryButton}" Click="SendMessage_Click" MinWidth="100" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <TextBlock Text="支持双向发起连接和传输中追加队列；跨隔离网段推荐由可信的发送端主动连接接收端。" Foreground="#64748B" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="UpdateStatusText" Text="更新：尚未检查" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" Margin="0,0,10,0"/>
                    <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Padding="10,4"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
